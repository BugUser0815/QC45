# Copy to /home/mobie/evcsd/qc45-integration.properties

# ChargePoint / OCPP 1.6 JSON over WSS
ocpp.url=wss://example.invalid/ocpp/cp/socket/16/QC45
ocpp.username=QC45
ocpp.password=CHANGE_ME
ocpp.tls.caFile=/home/mobie/evcsd/ocpp-ca.pem
ocpp.tls.insecure=false

# Legacy EVCSD OCPP 1.5 SOAP -> OCPP 1.6 bridge
ocpp15.loopback.enabled=true
ocpp15.loopback.bind=127.0.0.1
ocpp15.loopback.port=9000
ocpp15.loopback.path=/QC45
ocpp15.loopback.heartbeatInterval=60
ocpp15.bridge.timeoutMs=10000

# evcc / local load management
modbus.port=1502

# Optional runtime-only override for the EFACEC QuickCharge protocol.
# Leave commented to use the value loaded by EVCSD from its normal configuration.
# Setting 3 patches both Configuration.QCProtocolVersion and the already-created
# live QuickChargeSerializer instance(s). It does NOT write the Derby database.
#evcsd.qcProtocolVersion=3

# CCS quick-charge maximum current. Applied in-memory to connector 2 at startup.
# Defaults to 30 A if this property is omitted. Derby is not modified.
evcsd.quickChargeMaxCurrentA=30

# Test-only CCS hardware metadata override for connector 2. EVCSD normally
# initializes SatelliteStation to 125 A / 50000 W during SatelliteModule.init().
# These values are applied afterwards to the live object without calling
# Database.updateEntity(). Remove/comment both lines to disable the override.
evcsd.ccsHardwareMaxCurrentA=30
evcsd.ccsHardwareMaxPowerW=11000

# Sparse raw serial trace for QuickCharge/CCS diagnosis. The tracer wraps the
# already-open serial streams in memory and does not modify protocol state.
# Changed frames are logged immediately; identical frames are repeated at most
# once per repeatMs. Disable again after Kona/Mini comparison.
evcsd.ccsRawTrace.enabled=true
evcsd.ccsRawTrace.repeatMs=1000

# Lightweight EVCSD internal executor lag probe.
# One tiny marker task per interval; warnings are logged above warnMs.
evcsd.lagmonitor.enabled=true
evcsd.lagmonitor.intervalMs=60000
evcsd.lagmonitor.warnMs=250

# KOSTAL KSEM shared by LoadManager and GridFailback
ksem.host=10.0.0.70
ksem.port=502
ksem.unit=71
ksem.timeoutMs=1000
ksem.legacyLowWord=true
ksem.currentScale=0.001

# Native load manager
# Normal balancing controls DC connectors only. Type2 is not manipulated.
loadmanager.enabled=true
loadmanager.targetA=32.0
loadmanager.hysteresisA=0.8
loadmanager.minDcKw=5
loadmanager.maxDcKw=50
loadmanager.minAcKw=5
loadmanager.maxAcKw=22
loadmanager.rampUpKwPerLoop=2
loadmanager.intervalMs=1000

# Independent grid failback
failback.enabled=true
failback.reduceA=34.0
failback.reduceDelayMs=500
failback.reduceDcKw=5
failback.reduceAcKw=5
failback.tripA=35.0
failback.tripDelayMs=250
failback.instantTripA=38.0
failback.intervalMs=200
# Hard-trip latch clears automatically after this many ms continuously below reduceA.
failback.resetDelayMs=60000
# KSEM communication loss pauses charging at 0 kW but keeps transactions alive.
failback.tripOnMeterFailure=true
failback.meterFailureMs=3000
