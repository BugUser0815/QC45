# Copy to /home/mobie/evcsd/qc45-integration.properties

# ChargePoint / OCPP 1.6 JSON over WSS
ocpp.enabled=true
ocpp.url=wss://example.invalid/ocpp/cp/socket/16/QC45
ocpp.username=QC45
ocpp.password=CHANGE_ME
ocpp.tls.caFile=/home/mobie/evcsd/ocpp-ca.pem
ocpp.tls.insecure=false
# Persists active backend transaction-to-connector mappings across a webapp/JVM restart.
ocpp.transactionMapFile=/home/mobie/evcsd/qc45-active-transactions.properties

# Legacy EVCSD OCPP 1.5 SOAP -> OCPP 1.6 bridge
ocpp15.loopback.enabled=true
ocpp15.loopback.bind=127.0.0.1
ocpp15.loopback.port=9000
ocpp15.loopback.path=/QC45
ocpp15.loopback.heartbeatInterval=60
ocpp15.bridge.timeoutMs=10000

# Internal fleet AutoCharge (CCS / DIN only). Opt in after backend enrollment.
# The EVCCID itself is the OCPP idTag (12 uppercase hex digits, no prefix).
# The backend owns vehicle enrollment and authorization; no local mapping.
# Every attempt requires fresh Authorize Accepted. No offline authorization.
autocharge.enabled=false
# Use a persistent Geode internal address reachable from EVAcharge SE.
# Loopback is suitable only with an explicitly configured local tunnel.
autocharge.bindAddress=127.0.0.1
autocharge.port=15119
autocharge.allowedPeer=127.0.0.1
autocharge.keyFile=/home/mobie/evcsd/qc45-autocharge-observer.key
autocharge.authorizeTimeoutMs=10000

# Dashboard / Akkuboost
dashboard.akkuboost.url=http://10.0.20.131:7070

# evcc / local load management
# DC remains regulated. Type2/AC power is set directly in the original QC45;
# AC Modbus requests are recorded for compatibility but have no physical effect.
modbus.enabled=true
modbus.bindAddress=0.0.0.0
modbus.port=1502
# Comma-separated exact addresses or CIDR networks. Loopback is always allowed.
# This is the known evcc Raspberry Pi address; update it if that host changes.
modbus.allowedClients=10.0.0.179
modbus.maxClients=8

# CCS protocol handling
# The integration forces the live EFACEC QuickCharge/MasterProto serializers to
# protocol V3 in memory. No Derby value is changed. Do not add current or
# hardware-metadata overrides here; CCS V3 transports the requested power via
# MessageStateMachines.maxPower / byte 2 of the 0x63 START frame.

# Sparse raw serial trace for QuickCharge/CCS diagnosis. The TX hook wraps the
# actual OutputStream, therefore a line such as
#   CCS-RAW2 TX ... raw=63 02 0A ...
# proves that a 10 kW V3 START frame was handed to the serial/RXTX output path.
evcsd.ccsRawTrace.enabled=true
evcsd.ccsRawTrace.repeatMs=1000
# Trace data is written only during a validated CCS connection (including
# the 0 V handshake), with up to 2 seconds of bounded RAM pre-roll and a
# 5-second tail after disconnect. Live telemetry remains enabled while idle.
evcsd.ccsRawTrace.onlyWhenConnected=true
# Set false temporarily when diagnosing events before any cable indication.

# Full A19/QuickCharge RX trace for short reverse-engineering captures.
# During the same connection window, this logs every byte received on the
# physical master/CCS serial path, without the sparse 0x63 filter. It can
# generate a lot of log data. Keep it false during
# normal operation; enable it only while capturing a CCS plug-in/SLAC sequence.
# A restart of EVCSD is required after changing this switch.
evcsd.ccsRawTrace.fullRx.enabled=false
# Optional batching controls; defaults shown here.
evcsd.ccsRawTrace.fullRx.flushMs=40
evcsd.ccsRawTrace.fullRx.maxBytes=256

# Lightweight EVCSD internal executor lag probe.
# One tiny marker task per interval; warnings are logged above warnMs.
# Persistent lag >= 1000 ms for three consecutive probes arms a FULL DEVICE
# reboot. Reboot is deferred until all connectors have no active transaction,
# report 0 kW, and remain idle for 30 seconds. The Java process executes
# `sudo -n /sbin/reboot`, therefore the EVCSD runtime user must have passwordless
# permission for /sbin/reboot or the reboot attempt will be rejected and logged.
evcsd.lagmonitor.enabled=true
evcsd.lagmonitor.intervalMs=60000
evcsd.lagmonitor.warnMs=250
evcsd.lagmonitor.autoRestart=true
evcsd.lagmonitor.restartLagMs=1000
evcsd.lagmonitor.restartConsecutive=3
evcsd.lagmonitor.idleStableMs=30000
evcsd.lagmonitor.restartCommand=sudo -n /sbin/reboot

# KOSTAL KSEM shared by LoadManager and GridFailback
ksem.host=10.0.0.70
ksem.port=502
ksem.unit=71
ksem.timeoutMs=1000
ksem.currentScale=0.001
# 32-bit unsigned current registers. HIGH_LOW prevents rollover above 65.535 A.
ksem.wordOrder=HIGH_LOW

# Installed upstream SLS. Existing configurations without these keys use E35.
# Set the actual installed rating; all thermal/magnetic calculations use it.
sls.nominalA=35.0
sls.characteristic=E
# Supplemental software I^2/cooling policy, NOT a fitted Hager trip curve.
# 1000..30000 ms; smaller values intervene earlier on sustained overload.
sls.thermalTimeConstantMs=30000

# Native DC load manager
# DC is released directly from the remaining current headroom of the most
# heavily loaded KSEM phase. The configured target is bounded by the SLS
# rating; the QC45 DC power remains capped at 35 kW. SMA/BYD capability is not configured here:
# battery support is already visible as reduced KSEM grid current. If the
# battery is empty, the higher KSEM current automatically lowers the DC target.
# Type2/AC remains operator-fixed and is therefore treated as normal site load.
# Target, grid limit and hysteresis are active. Demand parameters are legacy.
# Every authorized CHAdeMO/CCS transaction starts at 5 kW; further increases
# require two DC catch-up readings and fit the available KSEM headroom.
loadmanager.enabled=true
loadmanager.targetA=34.0
loadmanager.gridLimitA=35.0
# Mo-Sa 06:30-18:00 Europe/Berlin; otherwise targetA/gridLimitA apply.
loadmanager.daytimeTargetA=25.0
# Hold band, bounded to 5% of the active target; not subtracted from targetA.
loadmanager.hysteresisA=1.5
loadmanager.minDcKw=5
loadmanager.maxDcKw=35
loadmanager.minAcKw=5
loadmanager.maxAcKw=43
loadmanager.rampUpKwPerLoop=5
loadmanager.intervalMs=1000
loadmanager.demandStableMs=5000
loadmanager.demandReserveKw=2

# Independent grid failback
# Both reduceA and tripA trigger proportional reductions, at most once/s.
# tripA is the faster trigger, NOT an immediate pause or fixed 5-kW command.
# With omitted keys defaults are In+1 A, In+3 A, and 5*In respectively.
# Explicit lower thresholds remain effective, including instantTripA.
failback.enabled=true
failback.reduceA=36.0
failback.reduceDelayMs=500
# Lower bounds of progressive reduction: 0 or technical minimum, never a raise.
failback.reduceDcKw=5
failback.reduceAcKw=5
failback.tripA=38.0
failback.tripDelayMs=250
# At most the lower magnetic boundary 5*In (175 A for E35, 250 A for E50).
# An explicit smaller value is respected; sustained overload also trips thermally.
failback.instantTripA=175.0
failback.intervalMs=100
# Hard-trip reset requires thermal recovery, inactive sessions and this many ms
# continuously below min(reduceA, In). Meter failures restart the reset timer.
# Minimum/default 60000 ms. Missing data never counts as thermal cooling.
failback.resetDelayMs=60000
# KSEM/control failure blocks managed outputs immediately (physical 5-kW floor).
# Five healthy readings are required before a fresh 5-kW start.
# For a future E50 replacement, also review the explicit values above:
# sls.nominalA=50, targetA=49, gridLimitA=50,
# reduceA=51, tripA=53, instantTripA=250; daytimeTargetA is independently chosen.

# DC requires an explicit positive evcc budget written to Modbus register 110.
# On startup the DC budget is 0; KSEM cannot grant power by itself.
# Positive DC permits expire 30 seconds after the last evcc write. The evcc
# driver must refresh them at least every 5-10 seconds. An unauthorized active
# CHAdeMO/CCS transaction receives RemoteStop (5kW native floor is NOT off).
# AC Type2 remains operator-fixed and is NOT controlled by this DC lease.
